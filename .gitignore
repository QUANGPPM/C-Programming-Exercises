# Git Ignore for C++ projects using CMake

# Build directories
build/
bin/
lib/

# Object files
*.o
*.obj

# Executables
*.exe
my_game_engine

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
CTestTestfile.cmake

# IDE specific files (common examples)
.vscode/
.idea/
*.user
*.suo

# Editor backup/swap files
*~
#*#